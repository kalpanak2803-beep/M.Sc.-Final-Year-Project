def get_working_model():
    for m in genai.list_models():
        if "generateContent" in m.supported_generation_methods:
            print("Using model:", m.name)
            return genai.GenerativeModel(m.name)
    raise Exception("No usable model found")

model = get_working_model()

def inscription_leaf_process(path, output_folder):
    try:
        # Open the image
        image = Image.open(path)
        
        # STEP 1: Text extraction from stone inscription
        extract_prompt = """
        Analyze this ancient Tamil stone inscription image.
        Extract ALL visible Tamil text characters accurately.
        Preserve the original Tamil script exactly as it appears.
        Include any numbers, symbols, or special characters.
        
        Format the output as:
        === STONE INSCRIPTION TEXT ===
        [Extracted Tamil text here]
        
        Note: If some characters are unclear or damaged, mark them with [?]
        """
        
        response1 = model.generate_content([extract_prompt, image])
        extracted_text = response1.text
        
        # Save extracted text
        txt_file = os.path.join(output_folder, "extracted_inscription.txt")
        with open(txt_file, "w", encoding="utf-8") as f:
            f.write(extracted_text)
        
        print("✅ Inscription text extracted")
        
        # STEP 2: Translation and explanation
        explain_prompt = f"""
        Analyze this ancient Tamil stone inscription text.
        
        1. Translate the text to modern Tamil
        2. Explain its historical significance
        3. Identify the probable time period
        4. Note any royal names or historical references
        5. Explain the purpose (donation, victory, construction, etc.)
        
        Text to analyze:
        {extracted_text}
        
        Format your response clearly with sections.
        """
        
        response2 = model.generate_content(explain_prompt)
        analysis_text = response2.text
        
        # Save as HTML
        save_as_html(analysis_text, os.path.join(output_folder, "output_text1.html"))
        
        # Save analysis text
        analysis_file = os.path.join(output_folder, "inscription_analysis.txt")
        with open(analysis_file, "w", encoding="utf-8") as f:
            f.write(analysis_text)
        
        print("✅ Inscription analysis completed")
        print("\n" + "="*50)
        print("INSCRIPTION ANALYSIS SUMMARY:")
        print("="*50)
        print(analysis_text[:500] + "..." if len(analysis_text) > 500 else analysis_text)
        
        return {
            'success': True,
            'extracted_text': extracted_text,
            'analysis': analysis_text,
            'html_file': 'output_text1.html'
        }
        
    except Exception as e:
        print(f"❌ Error processing inscription: {e}")
        return {
            'success': False,
            'error': str(e)
        }

