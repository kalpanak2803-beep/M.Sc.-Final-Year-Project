@app.route("/register", methods=["GET", "POST"])
def register():
    if request.method == "POST":
        try:
            name = request.form.get("fullname", "").strip()  # "name"， "fullname"
            email = request.form.get("email", "").strip().lower()
            password = request.form.get("password", "").strip()
            confirm_password = request.form.get("confirm_password", "").strip() 
            terms = request.form.get("terms") 

            print(
                f"Registration attempt - Name: {name}, Email: {email}, Password length: {len(password)}, Terms: {terms}")
            print(f"Form data: {request.form}")

            # Validation
            if not name or not email or not password:
                flash("All fields are required!", "error")
                return redirect(url_for('register'))

            if len(password) < 6:
                flash("Password must be at least 6 characters long!", "error")
                return redirect(url_for('register'))

            if password != confirm_password:
                flash("Passwords do not match!", "error")
                return redirect(url_for('register'))

            if not terms or terms != "on":  # HTML"on"
                flash("You must agree to the terms and conditions!", "error")
                return redirect(url_for('register'))

            if '@' not in email or '.' not in email:
                flash("Please enter a valid email address!", "error")
                return redirect(url_for('register'))

            # Hash password
            hashed_password = generate_password_hash(password)

            # Connect to database
            con = get_connection()
            if not con:
                flash("Database connection error. Please try again later.", "error")
                return redirect(url_for('register'))

            cur = con.cursor()

            # Check if user already exists
            cur.execute("SELECT id FROM users WHERE email = %s", (email,))
            existing_user = cur.fetchone()

            if existing_user:
                flash("Email already registered. Please login or use a different email.", "error")
                cur.close()
                con.close()
                return redirect(url_for('register'))

            # Insert new user
            cur.execute(
                "INSERT INTO users (name, email, password) VALUES (%s, %s, %s)",
                (name, email, hashed_password)
            )
            con.commit()

            # Get the new user ID
            user_id = cur.lastrowid

            # Log registration activity
            cur.execute(
                "INSERT INTO user_activities (user_id, activity_type, description) VALUES (%s, %s, %s)",
                (user_id, 'registration', 'User registered successfully')
            )
            con.commit()

            cur.close()
            con.close()

            flash("Registration successful! Please login to continue.", "success")
            return redirect(url_for('login'))

        except mysql.connector.Error as err:
            print(f"Registration error: {err}")
            flash("Registration failed. Please try again.", "error")
            return redirect(url_for('register'))
        except Exception as e:
            print(f"Unexpected error: {e}")
            flash("An error occurred. Please try again.", "error")
            return redirect(url_for('register'))

    return render_template("register.html")

@app.route("/login", methods=["GET", "POST"])
def login():
    if request.method == "POST":
        try:
            email = request.form.get("email", "").strip().lower()
            password = request.form.get("password", "").strip()

            if not email or not password:
                flash("Please enter both email and password!", "error")
                return redirect(url_for('login'))

            con = get_connection()
            if not con:
                flash("Database connection error. Please try again later.", "error")
                return redirect(url_for('login'))

            cur = con.cursor(dictionary=True)

            # Get user with email
            cur.execute("SELECT id, name, email, password FROM users WHERE email = %s AND status = 'active'", (email,))
            user = cur.fetchone()

            if user and check_password_hash(user['password'], password):
                # Update last login
                cur.execute("UPDATE users SET last_login = NOW() WHERE id = %s", (user['id'],))

                # Log login activity
                cur.execute(
                    "INSERT INTO user_activities (user_id, activity_type, description) VALUES (%s, %s, %s)",
                    (user['id'], 'login', 'User logged in successfully')
                )
                con.commit()

                # Set session
                session['user_id'] = user['id']
                session['user_name'] = user['name']
                session['user_email'] = user['email']
                session.permanent = True

                cur.close()
                con.close()

                flash(f"Welcome back, {user['name']}!", "success")
                return redirect(url_for('dashboard'))
            else:
                cur.close()
                con.close()
                flash("Invalid email or password!", "error")
                return redirect(url_for('login'))

        except Exception as e:
            print(f"Login error: {e}")
            flash("Login failed. Please try again.", "error")
            return redirect(url_for('login'))

    return render_template("login.html")


@app.route("/dashboard")
def dashboard():
    if "user_id" not in session:
        flash("Please login to access dashboard", "warning")
        return redirect(url_for('login'))

    try:
        con = get_connection()
        if not con:
            flash("Database connection error", "error")
            return redirect(url_for('login'))

        cur = con.cursor(dictionary=True)

        # Get user stats
        cur.execute("""
            SELECT 
                COUNT(*) as total_uploads,
                SUM(CASE WHEN status = 'completed' THEN 1 ELSE 0 END) as completed,
                SUM(CASE WHEN status = 'pending' THEN 1 ELSE 0 END) as pending
            FROM history 
            WHERE user_id = %s
        """, (session['user_id'],))
        stats = cur.fetchone()

        # Get recent activities
        cur.execute("""
            SELECT activity_type, description, created_at 
            FROM user_activities 
            WHERE user_id = %s 
            ORDER BY created_at DESC 
            LIMIT 10
        """, (session['user_id'],))
        activities = cur.fetchall()

        # Get upload history
        cur.execute("""
            SELECT artifact_type, original_filename, result_filename, processed_at, status
            FROM history 
            WHERE user_id = %s 
            ORDER BY processed_at DESC 
            LIMIT 5
        """, (session['user_id'],))
        history = cur.fetchall()

        cur.close()
        con.close()

        return render_template("dashboard.html",
                               stats=stats,
                               activities=activities,
                               history=history)

    except Exception as e:
        print(f"Dashboard error: {e}")
        flash("Error loading dashboard", "error")
        return render_template("dashboard.html", stats=None, activities=[], history=[])


@app.route("/upload", methods=["GET", "POST"])
def upload():
    if "user_id" not in session:
        flash("Please login to upload artifacts", "warning")
        return redirect(url_for('login'))

    if request.method == "POST":
        try:
            if 'image' not in request.files:
                flash("No file selected", "error")
                return redirect(request.url)

            file = request.files['image']
            task = request.form.get('task', 'palm')
            artifact_name = request.form.get('artifact_name', 'Unknown Artifact')

            if file.filename == '':
                flash("No file selected", "error")
                return redirect(request.url)

            # Validate file type
            allowed_extensions = {'png', 'jpg', 'jpeg', 'bmp', 'gif'}
            file_ext = file.filename.rsplit('.', 1)[1].lower() if '.' in file.filename else ''
            if file_ext not in allowed_extensions:
                flash("Invalid file type. Allowed: PNG, JPG, JPEG, BMP, GIF", "error")
                return redirect(request.url)

            # Generate unique filename
            unique_id = str(uuid.uuid4())[:8]
            file_ext = os.path.splitext(file.filename)[1]
            filename = f"{unique_id}_{session['user_id']}{file_ext}"

            # Save original file
            original_path = os.path.join(UPLOAD_FOLDER, filename)
            file.save(original_path)

            # Process based on task
            result_data = None
            result_template = None

            if task == "palm":
                result_data = palm_leaf_process(original_path, PALM_FOLDER)
                result_filename = "output_text.html"
                result_template = "palmresult.html"

            elif task == "inscription":
                result_data = inscription_leaf_process(original_path, INSCRIPTION_FOLDER)
                result_filename = "output_text1.html"
                result_template = "inscriptionresult.html"

            else:
                result_data = restore_sculpture(original_path, STONE_FOLDER)
                result_filename = "restored_sculpture.png"
                result_template = "stoneresult.html"

            # Save to history
            con = get_connection()
            if con:
                cur = con.cursor()
                cur.execute("""
                    INSERT INTO history(user_id, artifact_type, original_filename, result_filename, status)
                    VALUES(%s, %s, %s, %s, %s)
                """, (session['user_id'], task, filename, result_filename, 'completed'))

                # Log activity
                cur.execute("""
                    INSERT INTO user_activities (user_id, activity_type, description)
                    VALUES (%s, %s, %s)
                """, (session['user_id'], 'upload', f'Uploaded {task} artifact: {artifact_name}'))

                con.commit()
                cur.close()
                con.close()

            flash(f"Artifact processed successfully! Type: {task}", "success")
            return render_template(result_template,
                                   task=task,
                                   original_image=filename,
                                   restored_image=result_filename,
                                   artifact_name=artifact_name)

        except Exception as e:
            print(f"Upload error: {e}")
            flash(f"Error processing artifact: {str(e)}", "error")
            return redirect(request.url)

    return render_template("upload.html")


