from flask import send_file
import zipfile
import io
import os


@app.route("/download-zip", methods=["POST"])
def download_zip():
    if "user_id" not in session:
        flash("Please login to download files", "warning")
        return redirect(url_for('login'))

    try:
        item_ids = request.form.getlist('item_ids')

        # Create a ZIP file in memory
        memory_file = io.BytesIO()
        with zipfile.ZipFile(memory_file, 'w') as zf:
            for item_id in item_ids:
                # Get file information from database
                con = get_connection()
                cur = con.cursor(dictionary=True)
                cur.execute("""
                    SELECT artifact_type, result_filename 
                    FROM history 
                    WHERE id = %s AND user_id = %s
                """, (item_id, session['user_id']))
                item = cur.fetchone()
                cur.close()
                con.close()

                if item and item['result_filename']:
                    # Determine folder based on artifact type
                    if item['artifact_type'] == 'sculpture':
                        folder = STONE_FOLDER
                    elif item['artifact_type'] == 'inscription':
                        folder = INSCRIPTION_FOLDER
                    else:
                        folder = PALM_FOLDER

                    file_path = os.path.join(folder, item['result_filename'])
                    if os.path.exists(file_path):
                        # Add file to ZIP
                        zf.write(file_path, os.path.basename(file_path))

        memory_file.seek(0)

        return send_file(
            memory_file,
            mimetype='application/zip',
            as_attachment=True,
            download_name='tamil_artifacts.zip'
        )

    except Exception as e:
        print(f"ZIP download error: {e}")
        flash("Error creating ZIP file", "error")
        return redirect(url_for('gallery'))


import os
from flask import send_file, send_from_directory


@app.route('/download/<filename>')
def download_file(filename):
    """Download processed files from appropriate folders"""
    if "user_id" not in session:
        flash("Please login to download files", "warning")
        return redirect(url_for('login'))

    try:
        # Map artifact types to folders
        folder_map = {
            'output_text.html': 'static/palmupload',
            'output_text1.html': 'static/inscriptionupload',
            'restored_sculpture.png': 'static/stoneupload'
        }

        # Determine the folder based on filename
        folder = folder_map.get(filename, 'static/uploads')
        file_path = os.path.join(folder, filename)

        if os.path.exists(file_path):
            return send_file(
                file_path,
                as_attachment=True,
                download_name=filename
            )
        else:
            flash(f"File {filename} not found", "error")
            return redirect(url_for('gallery'))

    except Exception as e:
        print(f"Download error: {e}")
        flash("Error downloading file", "error")
        return redirect(url_for('gallery'))

