# Database connection
def get_connection():
    try:
        return mysql.connector.connect(
            host="localhost",
            user="root",
            password="",  # Add your MySQL password here if you have one
            database="tamil_restoration_db",
            auth_plugin='mysql_native_password'
        )
    except mysql.connector.Error as err:
        print(f"Database connection error: {err}")
        return None


def init_db():
    try:
        # First connect without database to create it if needed
        con = mysql.connector.connect(
            host="localhost",
            user="root",
            password="",
            auth_plugin='mysql_native_password'
        )
        cur = con.cursor()

        # Create database if it doesn't exist
        cur.execute(
            "CREATE DATABASE IF NOT EXISTS tamil_restoration_db CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci")
        con.commit()

        # Switch to the database
        cur.execute("USE tamil_restoration_db")

        # Users table
        cur.execute("""
            CREATE TABLE IF NOT EXISTS users(
                id INT AUTO_INCREMENT PRIMARY KEY,
                name VARCHAR(100) NOT NULL,
                email VARCHAR(100) UNIQUE NOT NULL,
                password VARCHAR(255) NOT NULL,
                created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
                last_login DATETIME,
                status ENUM('active', 'inactive') DEFAULT 'active'
            ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
        """)

        # History table
        cur.execute("""
            CREATE TABLE IF NOT EXISTS history(
                id INT AUTO_INCREMENT PRIMARY KEY,
                user_id INT NOT NULL,
                artifact_type VARCHAR(50) NOT NULL,
                original_filename VARCHAR(255),
                result_filename VARCHAR(255),
                processed_at DATETIME DEFAULT CURRENT_TIMESTAMP,
                status VARCHAR(50),
                FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
            ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
        """)

        # User activities table
        cur.execute("""
            CREATE TABLE IF NOT EXISTS user_activities(
                id INT AUTO_INCREMENT PRIMARY KEY,
                user_id INT NOT NULL,
                activity_type VARCHAR(50),
                description TEXT,
                created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
                FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
            ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
        """)

        con.commit()
        print("✅ Database initialized successfully")

    except mysql.connector.Error as err:
        print(f"❌ Database initialization error: {err}")
    finally:
        if 'cur' in locals():
            cur.close()
        if 'con' in locals():
            con.close()


init_db()


# Security functions
def generate_password_hash(p):
    return hashlib.sha256(p.encode()).hexdigest()


def check_password_hash(h, p):
    return h == hashlib.sha256(p.encode()).hexdigest()


